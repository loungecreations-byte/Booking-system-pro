# =====================================================================
#  FILE: product-planner.refresh.codex
#  PURPOSE: Verbetert WooCommerce productpagina (planner) — lichtgewicht
#           - Nieuwe summary-card (datum/tijd/pax, prijs, CTA's)
#           - Rechter Planner-Dock met kalender-popover (desktop) + sticky mobiel
#           - REST endpoints: prijs (/price) en timeslots (/slots) + hooks/filters
#           - Elementor-vriendelijk (shortcodes)
#           - Cart item data (date/time/pax) + Book Direct flow
# =====================================================================

task: product.page-refresh
output-policy: [verbose, color, fail-fast]

vars:
  plugin_slug: "ddb-product-layout"
  plugin_dir: "wp-content/plugins/ddb-product-layout"
  ns: "DDB\\ProductLayout"
  rest_ns: "ddb/v1"
  feature_flag: "ddb_product_layout_enabled"
  dock_flag: "ddb_planner_dock_enabled"

steps:

# 0) Mappen & plugin scaffold
- name: "Scaffold plugin directories"
  run: >
    agent.run("fs.ensure_dirs", { paths: [
      "${{vars.plugin_dir}}",
      "${{vars.plugin_dir}}/includes",
      "${{vars.plugin_dir}}/includes/Rest",
      "${{vars.plugin_dir}}/includes/Services",
      "${{vars.plugin_dir}}/includes/Domain",
      "${{vars.plugin_dir}}/assets",
      "${{vars.plugin_dir}}/views"
    ]});

# 1) Hoofd-pluginbestand
- name: "Create main plugin file"
  run: >
    agent.run("fs.write", {
      path: "${{vars.plugin_dir}}/ddb-product-layout.php",
      content: `<?php
/**
 * Plugin Name: DDB Product Layout
 * Description: Schone productplanner met summary-card, Planner-Dock, REST pricing/slots en sticky CTA.
 * Author: DagjeDenBosch.nl
 * Version: 0.2.0
 */

if (!defined('ABSPATH')) { exit; }

define('DDB_PLUG', __FILE__);
define('DDB_PLUG_DIR', plugin_dir_path(__FILE__));
define('DDB_PLUG_URL', plugin_dir_url(__FILE__));

register_activation_hook(__FILE__, function(){
  add_option('${{vars.feature_flag}}', '1');
  add_option('${{vars.dock_flag}}', '1');
});

spl_autoload_register(function($class){
  if (strpos($class, '${{vars.ns}}') !== 0) return;
  $path = DDB_PLUG_DIR . 'includes/' . str_replace(['${{vars.ns}}\\', '\\\\'], ['', '/'], $class) . '.php';
  if (file_exists($path)) require_once $path;
});

add_action('plugins_loaded', function(){
  if (get_option('${{vars.feature_flag}}') !== '1') return;

  (new ${{vars.ns}}\\Assets())->init();
  (new ${{vars.ns}}\\Hooks())->init();

  (new ${{vars.ns}}\\Rest\\Price())->init();
  (new ${{vars.ns}}\\Rest\\Slots())->init(); // nieuwe timeslots endpoint
});
`
    });

# 2) Assets loader
- name: "Create Assets loader"
  run: >
    agent.run("fs.write", {
      path: "${{vars.plugin_dir}}/includes/Assets.php",
      content: `<?php
namespace ${{vars.ns}};

class Assets {
  public function init(){
    add_action('wp_enqueue_scripts', [$this,'enqueue']);
  }
  public function enqueue(){
    if (!is_product() && !is_page()) return;

    // Alleen laden op productpagina's en (optioneel) /plan-je-dag
    $is_planner_page = function_exists('is_page') && (is_page('plan-je-dag') || is_page('planner'));
    if (!is_product() && !$is_planner_page) return;

    wp_enqueue_style('ddb-product', DDB_PLUG_URL.'assets/ddb-product.css', [], '0.2.0');
    wp_enqueue_script('ddb-product', DDB_PLUG_URL.'assets/ddb-product.js', [], '0.2.0', true);

    wp_localize_script('ddb-product', 'DDB_PRODUCT', [
      'rest' => [
        'price' => esc_url_raw( rest_url('${{vars.rest_ns}}/price') ),
        'slots' => esc_url_raw( rest_url('${{vars.rest_ns}}/slots') ),
        'nonce' => wp_create_nonce('wp_rest')
      ],
      'flags' => [
        'dock' => get_option('${{vars.dock_flag}}') === '1'
      ],
      'i18n' => [
        'selectDate' => __('Kies eerst een datum','ddb'),
        'selectTime' => __('Kies een tijd','ddb'),
        'selectPax'  => __('Vul aantal personen in','ddb'),
        'unavailable'=> __('Niet beschikbaar','ddb')
      ]
    ]);
  }
}
`
    });

# 3) Hooks: summary + planner-dock + cart data
- name: "Create Hooks"
  run: >
    agent.run("fs.write", {
      path: "${{vars.plugin_dir}}/includes/Hooks.php",
      content: `<?php
namespace ${{vars.ns}};

class Hooks {
  public function init(){
    // Summary vervangen door eigen card (laat titel bewaard via template)
    remove_action('woocommerce_single_product_summary','woocommerce_template_single_price',10);
    remove_action('woocommerce_single_product_summary','woocommerce_template_single_add_to_cart',30);
    add_action('woocommerce_single_product_summary', [$this,'render_summary_card'], 25);

    // Planner-Dock rechts (optioneel via feature-flag)
    add_action('woocommerce_after_single_product_summary', [$this,'render_planner_dock'], 5);

    // Sticky CTA in footer (mobiel)
    add_action('wp_footer', [$this,'render_sticky_cta']);

    // Cart item data: sla date/time/pax op in winkelmandje
    add_filter('woocommerce_add_cart_item_data', [$this,'add_cart_item_data'], 10, 3);
    add_filter('woocommerce_get_item_data', [$this,'display_cart_item_data'], 10, 2);

    // Shortcodes voor Elementor
    add_shortcode('ddb_summary_card', [$this,'shortcode_summary']);
    add_shortcode('ddb_planner_dock', [$this,'shortcode_dock']);
  }

  public function render_summary_card(){
    if (!is_product()) return;
    global $product;
    if (!$product instanceof \\WC_Product) return;
    include DDB_PLUG_DIR.'views/summary-card.php';
  }

  public function render_planner_dock(){
    if (!is_product()) return;
    if (get_option('${{vars.dock_flag}}') !== '1') return;
    global $product;
    if (!$product instanceof \\WC_Product) return;
    echo '<aside class="ddb-planner-dock-wrap">';
    include DDB_PLUG_DIR.'views/planner-dock.php';
    echo '</aside>';
  }

  public function render_sticky_cta(){
    if (!is_product()) return;
    echo '<div class="ddb-sticky-cta" hidden>
      <div class="ddb-sticky-meta" aria-live="polite"></div>
      <button class="button alt ddb-sticky-book">'.esc_html__('Boek direct','ddb').'</button>
    </div>';
  }

  public function add_cart_item_data($cart_item_data, $product_id, $variation_id){
    foreach (['ddb_date','ddb_time','ddb_pax'] as $k){
      if (!empty($_POST[$k])) $cart_item_data[$k] = sanitize_text_field($_POST[$k]);
    }
    return $cart_item_data;
  }

  public function display_cart_item_data($item_data, $cart_item){
    $map = [
      'ddb_date' => __('Datum','ddb'),
      'ddb_time' => __('Tijd','ddb'),
      'ddb_pax'  => __('Personen','ddb')
    ];
    foreach ($map as $key=>$label){
      if (!empty($cart_item[$key])){
        $item_data[] = ['name'=>$label,'value'=>esc_html($cart_item[$key])];
      }
    }
    return $item_data;
  }

  public function shortcode_summary($atts){
    ob_start();
    $this->render_summary_card();
    return ob_get_clean();
  }

  public function shortcode_dock($atts){
    ob_start();
    $this->render_planner_dock();
    return ob_get_clean();
  }
}
`
    });

# 4) REST endpoint voor prijs (ongewijzigd, maar klaar voor uitbreiding)
- name: "Create/Update REST Price controller"
  run: >
    agent.run("fs.write", {
      path: "${{vars.plugin_dir}}/includes/Rest/Price.php",
      content: `<?php
namespace ${{vars.ns}}\\Rest;

class Price {
  public function init(){
    add_action('rest_api_init', function(){
      register_rest_route('${{vars.rest_ns}}','/price', [
        'methods' => 'GET',
        'permission_callback' => '__return_true',
        'callback' => [$this,'handle']
      ]);
    });
  }

  public function handle($req){
    $product_id = absint($req['product_id']);
    $pax = max(1, intval($req['pax']));
    $date = sanitize_text_field($req['date']);
    $time = sanitize_text_field($req['time']);

    if (!$product_id) return new \\WP_Error('bad_request','product_id missing', ['status'=>400]);

    $product = wc_get_product($product_id);
    if (!$product) return new \\WP_Error('not_found','product not found', ['status'=>404]);

    // Eenvoudige prijslogica (placeholder): per-person of base + per-person
    $base = (float) get_post_meta($product_id,'_ddb_base_price', true);
    $per  = (float) get_post_meta($product_id,'_ddb_per_person', true);
    if ($per <= 0 && $product) { $per = (float) $product->get_price(); }

    $subtotal = max(0,$base) + max(0,$per) * $pax;

    $response = [
      'product_id' => $product_id,
      'pax' => $pax,
      'date' => $date,
      'time' => $time,
      'price' => wc_price($subtotal),
      'raw' => ['base'=>$base, 'per_person'=>$per, 'subtotal'=>$subtotal],
      'availability' => ['ok' => true] // kan door Slots/filters worden beïnvloed
    ];
    return rest_ensure_response($response);
  }
}
`
    });

# 5) REST endpoint voor timeslots (met filters/blackouts/capaciteit)
- name: "Create REST Slots controller"
  run: >
    agent.run("fs.write", {
      path: "${{vars.plugin_dir}}/includes/Rest/Slots.php",
      content: `<?php
namespace ${{vars.ns}}\\Rest;

class Slots {
  public function init(){
    add_action('rest_api_init', function(){
      register_rest_route('${{vars.rest_ns}}','/slots', [
        'methods' => 'GET',
        'permission_callback' => '__return_true',
        'callback' => [$this,'handle']
      ]);
    });
  }

  public function handle($req){
    $product_id = absint($req['product_id']);
    $date = sanitize_text_field($req['date']);
    if (!$product_id || !$date) {
      return new \\WP_Error('bad_request','product_id/date missing', ['status'=>400]);
    }

    // Meta: CSV timeslots, JSON days_allowed, CSV blackouts, capacity_per_slot
    $timeslots = array_filter(array_map('trim', explode(',', (string)get_post_meta($product_id, '_ddb_timeslots', true))));
    if (empty($timeslots)) $timeslots = ['09:00','10:00','13:00','15:00'];

    $days_allowed = json_decode((string)get_post_meta($product_id,'_ddb_days_allowed', true), true) ?: [];
    if (!empty($days_allowed)) {
      $weekday = (int) date('N', strtotime($date));
      if (!in_array($weekday, $days_allowed, true)) {
        return rest_ensure_response(['date'=>$date,'slots'=>[]]); // niet boekbaar
      }
    }

    $blackouts = array_filter(array_map('trim', explode(',', (string)get_post_meta($product_id, '_ddb_blackout_dates', true))));
    if (in_array($date, $blackouts, true)) {
      return rest_ensure_response(['date'=>$date,'slots'=>[]]);
    }

    $cap = (int) (get_post_meta($product_id,'_ddb_capacity_per_slot', true) ?: 0);

    $slots = [];
    foreach ($timeslots as $t){
      $status = 'free';
      $used = apply_filters('ddb_reserved_count', 0, $product_id, $date, $t);
      if ($cap > 0 && $used >= $cap) $status = 'full';
      $slots[] = ['time'=>$t,'status'=>$status,'used'=>$used,'cap'=>$cap];
    }

    // Externe planner kan volledige slots-list overschrijven
    $slots = apply_filters('ddb_planner_slots', $slots, $product_id, $date);

    return rest_ensure_response(['date'=>$date,'slots'=>$slots]);
  }
}
`
    });

# 6) Summary view (bestaand)
- name: "Create summary-card view"
  run: >
    agent.run("fs.write", {
      path: "${{vars.plugin_dir}}/views/summary-card.php",
      content: `<?php
/** @var WC_Product $product */
?>
<div class="ddb-summary" data-product-id="<?php echo esc_attr($product->get_id()); ?>">
  <div class="ddb-usp">
    <ul>
      <li>⏱ <?php echo esc_html(get_post_meta($product->get_id(),'_ddb_duration','2 uur')); ?></li>
      <li>👥 <?php echo esc_html(get_post_meta($product->get_id(),'_ddb_group_hint','Ideaal: 8–20 p.')); ?></li>
      <li>📍 <?php echo esc_html(get_post_meta($product->get_id(),'_ddb_start_loc','Centrum Den Bosch')); ?></li>
    </ul>
  </div>

  <div class="ddb-row">
    <label for="ddb_date"><?php esc_html_e('Datum','ddb'); ?></label>
    <input type="date" id="ddb_date" name="ddb_date" min="<?php echo esc_attr(date('Y-m-d')); ?>" />
  </div>

  <div class="ddb-row">
    <label for="ddb_time"><?php esc_html_e('Tijd','ddb'); ?></label>
    <select id="ddb_time" name="ddb_time">
      <option value=""><?php esc_html_e('Kies tijd','ddb'); ?></option>
    </select>
  </div>

  <div class="ddb-row">
    <label for="ddb_pax"><?php esc_html_e('Personen','ddb'); ?></label>
    <input type="number" id="ddb_pax" name="ddb_pax" min="1" value="1" />
  </div>

  <div class="ddb-price" aria-live="polite">
    <span class="ddb-price-label"><?php esc_html_e('Totaal','ddb'); ?>:</span>
    <span class="ddb-price-value"><?php echo wc_price(0); ?></span>
  </div>

  <div class="ddb-actions">
    <form class="ddb-add-to-cart" method="post" action="<?php echo esc_url( wc_get_cart_url() ); ?>">
      <input type="hidden" name="add-to-cart" value="<?php echo esc_attr($product->get_id()); ?>" />
      <input type="hidden" name="ddb_date" />
      <input type="hidden" name="ddb_time" />
      <input type="hidden" name="ddb_pax" />
      <button type="submit" class="button alt" disabled><?php esc_html_e('Boek direct','ddb'); ?></button>
    </form>
    <a href="#" class="button button-secondary ddb-plan-day"><?php esc_html_e('Plan mijn dag','ddb'); ?></a>
  </div>
</div>
`
    });

# 7) Planner-Dock view (rechts, popovers)
- name: "Create planner-dock view"
  run: >
    agent.run("fs.write", {
      path: "${{vars.plugin_dir}}/views/planner-dock.php",
      content: `<?php
/** @var WC_Product $product */
?>
<aside class="ddb-planner-dock" data-product-id="<?php echo esc_attr($product->get_id()); ?>" aria-label="<?php esc_attr_e('Plan je dag','ddb'); ?>">
  <button class="planner-field" data-pop="date" aria-expanded="false">
    <span>📅 <?php esc_html_e('Datum','ddb'); ?></span>
    <strong data-bind="dateLabel"><?php esc_html_e('Kies datum','ddb'); ?></strong>
  </button>
  <div class="popover" data-popover="date" hidden>
    <input type="date" min="<?php echo esc_attr(date('Y-m-d')); ?>" />
  </div>

  <button class="planner-field" data-pop="time" aria-expanded="false" disabled>
    <span>⏱ <?php esc_html_e('Tijd','ddb'); ?></span>
    <strong data-bind="timeLabel"><?php esc_html_e('Kies tijd','ddb'); ?></strong>
