`
    });

# 8) CSS (samengevoegd: summary + dock + sticky)
- name: "Create CSS"
  run: >
    agent.run("fs.write", {
      path: "${{vars.plugin_dir}}/assets/ddb-product.css",
      content: `/* Summary card */
.ddb-summary{border:1px solid #E9EEF3;border-radius:12px;padding:16px;background:#fff;box-shadow:0 2px 10px rgba(0,0,0,.03)}
.ddb-usp ul{margin:0 0 12px;padding-left:18px}
.ddb-row{margin-bottom:12px}
.ddb-row label{display:block;font-size:.9rem;color:#4a5568;margin-bottom:4px}
.ddb-price{display:flex;justify-content:space-between;align-items:center;font-weight:600;margin:10px 0 16px}
.ddb-actions{display:flex;gap:10px;flex-wrap:wrap}
.ddb-actions .button{padding:.65rem 1rem;border-radius:8px}

/* Planner Dock (right) */
.ddb-planner-dock-wrap{position:relative}
.ddb-planner-dock{position:sticky; top:96px; border:1px solid #E9EEF3; border-radius:12px; padding:14px; background:#fff; box-shadow:0 2px 10px rgba(0,0,0,.03); max-width:360px; margin-left:auto}
.planner-field{width:100%; display:flex; justify-content:space-between; align-items:center; gap:8px; padding:10px 12px; border:1px solid #E9EEF3; border-radius:10px; background:#fff; margin-bottom:10px}
.planner-field[disabled]{opacity:.6; pointer-events:none}
.planner-field strong{font-weight:600}
.popover{position:relative; border:1px solid #E9EEF3; border-radius:10px; padding:10px; margin:-4px 0 10px; background:#fff}
.popover .slots{display:flex; flex-wrap:wrap; gap:8px}
.popover .slots button{border:1px solid #E9EEF3; border-radius:8px; padding:6px 10px; background:#fff}
.popover .slots button[disabled], .popver .slots button.full{opacity:.4}
.planner-total{display:flex; justify-content:space-between; align-items:center; font-weight:600; margin:8px 0 12px}
.dock-book .btn-primary, .btn-secondary{padding:.65rem 1rem; border-radius:8px; width:100%}
.btn-secondary{background:#f6f7f9; border:1px solid #E9EEF3}
.planner-notice{margin-top:8px; font-size:.95rem}

/* Sticky CTA (mobile) */
@media(max-width:768px){
  .ddb-sticky-cta{position:fixed;left:0;right:0;bottom:0;background:#fff;border-top:1px solid #E9EEF3;
    padding:10px 14px;display:flex;gap:12px;align-items:center;z-index:99;box-shadow:0 -6px 20px rgba(0,0,0,.06)}
  .ddb-sticky-cta .ddb-sticky-meta{font-weight:600}
  .ddb-sticky-cta .button{flex:1}
}
`
    });

# 9) JS (samengevoegd: summary + dock + slots + prijs + popovers)
- name: "Create JS"
  run: >
    agent.run("fs.write", {
      path: "${{vars.plugin_dir}}/assets/ddb-product.js",
      content: `(function(){
  const qs = (s, el=document) => el.querySelector(s);
  const qsa = (s, el=document) => Array.from(el.querySelectorAll(s));

  function fmtPrice(html){ const d=document.createElement('div'); d.innerHTML=html||''; return d.textContent||'—'; }

  async function apiGet(url){
    const res = await fetch(url, { headers: { 'X-WP-Nonce': (window.DDB_PRODUCT||{}).rest?.nonce || '' }});
    return res.json();
  }

  // ---------- SUMMARY CARD ----------
  const summary = qs('.ddb-summary');
  if (summary && window.DDB_PRODUCT){
    const pid = summary.getAttribute('data-product-id');
    const date = qs('#ddb_date', summary);
    const time = qs('#ddb_time', summary);
    const pax  = qs('#ddb_pax', summary);
    const price = qs('.ddb-price-value', summary);
    const bookBtn = qs('.ddb-add-to-cart button', summary);
    const form = qs('.ddb-add-to-cart', summary);
    const hidDate = qs('input[name=ddb_date]', summary);
    const hidTime = qs('input[name=ddb_time]', summary);
    const hidPax  = qs('input[name=ddb_pax]', summary);
    const sticky = qs('.ddb-sticky-cta');
    const stickyMeta = sticky ? qs('.ddb-sticky-meta', sticky) : null;

    function ready(){ return date.value && time.value && parseInt(pax.value,10) > 0; }
    async function loadSlots(){
      if (!date.value) { time.innerHTML = '<option value="">'+(DDB_PRODUCT.i18n?.selectTime||'Kies tijd')+'</option>'; return; }
      const u = DDB_PRODUCT.rest.slots + '?product_id='+pid+'&date='+encodeURIComponent(date.value);
      const data = await apiGet(u);
      time.innerHTML = '<option value="">'+(DDB_PRODUCT.i18n?.selectTime||'Kies tijd')+'</option>';
      (data.slots||[]).forEach(s=>{
        const opt = document.createElement('option');
        opt.value = s.time; opt.textContent = s.time; if (s.status==='full') opt.disabled = true;
        time.appendChild(opt);
      });
    }
    async function refresh(){
      if (!ready()){ price.textContent = '—'; bookBtn.disabled=true; if (sticky) sticky.hidden = true; return; }
      const u = DDB_PRODUCT.rest.price + '?product_id='+pid+'&date='+encodeURIComponent(date.value)+'&time='+encodeURIComponent(time.value)+'&pax='+encodeURIComponent(pax.value);
      try{
        const data = await apiGet(u);
        price.innerHTML = data.price || '—';
        bookBtn.disabled = false;
        if (sticky && stickyMeta){ stickyMeta.textContent = time.value+' • '+pax.value+'p • '+fmtPrice(data.price); sticky.hidden=false; }
      }catch(e){ console.warn(e); }
    }
    function sync(){ hidDate.value=date.value; hidTime.value=time.value; hidPax.value=pax.value; }

    date.addEventListener('change', ()=>{ sync(); loadSlots().then(refresh); });
    time.addEventListener('change', ()=>{ sync(); refresh(); });
    pax .addEventListener('input',  ()=>{ sync(); refresh(); });

    // init
    sync(); loadSlots().then(refresh);
  }

  // ---------- PLANNER DOCK ----------
  if (window.DDB_PRODUCT?.flags?.dock){
    const dock = qs('.ddb-planner-dock');
    if (dock){
      const pid = dock.getAttribute('data-product-id');
      const popDate = qs('[data-popover="date"] input', dock);
      const popTime = qs('[data-popover="time"] .slots', dock);
      const fieldDate = qs('[data-pop="date"]', dock);
      const fieldTime = qs('[data-pop="time"]', dock);
      const pax = qs('[data-ref="pax"]', dock);
      const total = qs('[data-bind="total"]', dock);
      const ctaText = qs('[data-bind="ctaText"]', dock);
      const bookBtn = qs('[data-ref="bookCta"]', dock);
      const notice = qs('.planner-notice', dock);
      const hidDate = qs('input[name=ddb_date"]', dock) || qs('input[name=ddb_date]', dock);
      const hidTime = qs('input[name=ddb_time"]', dock) || qs('input[name=ddb_time]', dock);
      const hidPax  = qs('input[name=ddb_pax"]', dock)  || qs('input[name=ddb_pax]', dock);

      function togglePopover(which, show){
        const trg = qs('[data-popover="'+which+'"]', dock);
        if (!trg) return;
        trg.hidden = !show;
        const btn = qs('[data-pop="'+which+'"]', dock);
        if (btn) btn.setAttribute('aria-expanded', show ? 'true':'false');
      }
      document.addEventListener('click', (e)=>{
        if (!dock.contains(e.target)) { togglePopover('date', false); togglePopover('time', false); }
      });

      fieldDate.addEventListener('click', ()=> togglePopover('date', qs('[data-popover="date"]', dock).hidden));
      fieldTime.addEventListener('click', ()=> { if (!fieldTime.hasAttribute('disabled')) togglePopover('time', qs('[data-popover="time"]', dock).hidden); });

      async function loadSlots(){
        if (!popDate.value){ fieldTime.setAttribute('disabled',''); popTime.innerHTML=''; return; }
        const u = DDB_PRODUCT.rest.slots + '?product_id='+pid+'&date='+encodeURIComponent(popDate.value);
        const data = await apiGet(u);
        popTime.innerHTML = '';
        (data.slots||[]).forEach(s=>{
          const b = document.createElement('button');
          b.type='button'; b.textContent=s.time;
          if (s.status==='full') b.disabled = true;
          b.addEventListener('click', ()=>{ qs('[data-bind="timeLabel"]', dock).textContent = s.time; hidTime.value=s.time; togglePopover('time', false); refresh(); });
          popTime.appendChild(b);
        });
        fieldTime.removeAttribute('disabled');
      }

      async function refresh(){
        notice.textContent='';
        if (!(popDate.value && hidTime.value && parseInt(pax.value||'0',10) > 0)){
          total.textContent='—'; bookBtn.disabled=true; ctaText.textContent = DDB_PRODUCT.i18n?.selectDate || 'Kies eerst een datum'; return;
        }
        const u = DDB_PRODUCT.rest.price + '?product_id='+pid+'&date='+encodeURIComponent(popDate.value)+'&time='+encodeURIComponent(hidTime.value)+'&pax='+encodeURIComponent(pax.value);
        try{
          const data = await apiGet(u);
          total.textContent = fmtPrice(data.price);
          ctaText.textContent = (hidTime.value+' • '+(pax.value+'p')+' • '+fmtPrice(data.price));
          bookBtn.disabled = !(data.availability?.ok ?? true);
          if (!bookBtn.disabled && fmtPrice(data.price) !== '—'){ /* ok */ } else if (data.notice){ notice.innerHTML = data.notice.replace(/\\n/g,'<br>'); }
        }catch(e){ console.warn(e); }
      }

      popDate.addEventListener('change', ()=>{
        qs('[data-bind="dateLabel"]', dock).textContent = popDate.value;
        hidDate.value = popDate.value;
        togglePopover('date', false);
        loadSlots().then(refresh);
      });
      pax.addEventListener('input', ()=>{ hidPax.value = pax.value; refresh(); });

      // init
      hidPax.value = pax.value;
      refresh();

      // Planner CTA → plannerpagina met payload
      const planCta = qs('[data-ref="planCta"]', dock);
      if (planCta){
        planCta.addEventListener('click', (e)=>{
          e.preventDefault();
          const payload = new URLSearchParams({
            product_id: pid,
            date: popDate.value || '',
            time: hidTime.value || '',
            pax: pax.value || '1'
          }).toString();
          window.location.href = '/plan-je-dag/?'+payload;
        });
      }
    }
  }
})();`
    });

# 10) Flags aanzetten via WP-CLI (optioneel)
- name: "Enable feature flags"
  run: >
    if (agent.run("sh.which", {"bin":"wp"})) {
      agent.run("sh.exec", {"cmd":"wp option update ${{vars.feature_flag}} 1 || true"});
      agent.run("sh.exec", {"cmd":"wp option update ${{vars.dock_flag}} 1 || true"});
    }

# 11) Log meta keys (admin hints)
- name: "Instruction log"
  run: >
    agent.log.info("Klaar ✅ Nieuwe summary-card + Planner-Dock actief.");
    agent.log.info("REST: /${{vars.rest_ns}}/price, /${{vars.rest_ns}}/slots");
    agent.log.info("Zet per product meta: _ddb_base_price, _ddb_per_person, _ddb_timeslots (CSV), _ddb_days_allowed (JSON [1..7]), _ddb_blackout_dates (CSV), _ddb_capacity_per_slot (int)");
    agent.log.info("Feature flags: ${{vars.feature_flag}} (layout) en ${{vars.dock_flag}} (dock)");
    agent.log.info("Shortcodes: [ddb_summary_card] en [ddb_planner_dock]");
