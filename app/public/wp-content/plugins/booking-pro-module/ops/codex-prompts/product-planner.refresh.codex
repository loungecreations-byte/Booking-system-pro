  <form class="dock-book" method="post" action="<?php echo esc_url( wc_get_cart_url() ); ?>">
    <input type="hidden" name="add-to-cart" value="<?php echo esc_attr($product->get_id()); ?>" />
    <input type="hidden" name="ddb_date" />
    <input type="hidden" name="ddb_time" />
    <input type="hidden" name="ddb_pax" />
    <button type="submit" class="btn-primary" disabled data-ref="bookCta"><span data-bind="ctaText"><?php esc_html_e('Selecteer datum/tijd','ddb'); ?></span></button>
