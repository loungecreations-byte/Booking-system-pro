          }
        },
        {
          "id": "intro-text",
          "elType": "widget",
          "widgetType": "text-editor",
          "settings": {
            "editor": "<p>Gebruik deze sectie voor een korte context van 2-3 zinnen.</p>"
          }
        },
        {
          "id": "intro-button",
          "elType": "widget",
          "widgetType": "button",
          "settings": {
            "text": "Meer lezen",
            "link": {
              "url": "#"
