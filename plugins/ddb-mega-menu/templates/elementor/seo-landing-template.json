{
  "version": "0.4",
  "title": "DDB SEO Landing Page Template",
  "type": "page",
  "page_settings": {
    "hide_title": "yes"
  },
  "content": [
    {
      "id": "hero",
      "elType": "container",
      "settings": {
        "_css_classes": "ui-section ui-section--hero",
        "content_width": "boxed",
        "boxed_width": {
          "unit": "px",
          "size": 1240
        }
      },
      "elements": [
        {
          "id": "hero-heading",
          "elType": "widget",
          "widgetType": "heading",
          "settings": {
            "title": "Lokale inspiratie voor elke doelgroep",
            "tag": "h2",
            "_css_classes": "ui-section__title"
          }
        },
        {
          "id": "hero-text",
          "elType": "widget",
          "widgetType": "text-editor",
          "settings": {
            "editor": "<p>Geoptimaliseerde landingspagina met heldere structuur en sterke CTA's.</p>"
          }
        },
        {
          "id": "hero-button",
          "elType": "widget",
          "widgetType": "button",
          "settings": {
            "text": "Plan je dag",
            "link": {
              "url": "/plan-je-dag/"
            },
            "_css_classes": "ui-btn ui-btn--primary"
          }
        }
      ]
    },
    {
      "id": "intro",
      "elType": "container",
      "settings": {
        "_css_classes": "ui-section",
        "content_width": "boxed",
        "boxed_width": {
          "unit": "px",
          "size": 1240
        }
      },
      "elements": [
        {
          "id": "intro-heading",
          "elType": "widget",
          "widgetType": "heading",
          "settings": {
            "title": "Intro",
            "tag": "h2",
