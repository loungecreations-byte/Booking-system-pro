{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dagjedenbosch.nl/schemas/assistant_response.schema.json",
  "title": "AssistantResponse",
  "type": "object",
  "required": [
    "type",
    "schema_version",
    "trace_id",
    "primary",
    "alternatives",
    "plan",
    "questions",
    "decision_trace"
  ],
  "properties": {
    "type": {
      "const": "assistant_response"
    },
    "schema_version": {
      "type": "string"
    },
    "trace_id": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "primary": {
      "$ref": "#/$defs/candidateWithReason"
    },
    "alternatives": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "plan": {
      "type": "object",
      "required": ["timeline"],
      "properties": {
        "timeline": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/timelineItem"
          }
        }
      },
      "additionalProperties": true
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision_trace": {
      "type": "object"
    }
  },
  "$defs": {
    "cta": {
      "type": "object",
      "required": ["label", "url", "kind"],
      "properties": {
        "label": { "type": "string" },
        "url": { "type": "string" },
        "kind": { "enum": ["book", "refine", "human"] }
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": ["kind", "id", "title", "cta"],
      "properties": {
        "kind": { "enum": ["offer", "spot"] },
        "id": { "type": ["string", "number", "integer"] },
        "title": { "type": "string" },
        "cta": {
          "type": "array",
          "items": { "$ref": "#/$defs/cta" }
        }
      },
      "additionalProperties": true
    },
    "candidateWithReason": {
      "allOf": [
        { "$ref": "#/$defs/candidate" },
        {
          "type": "object",
          "required": ["reason_bullets"],
          "properties": {
            "reason_bullets": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      ]
    },
    "timelineItem": {
      "type": "object",
      "required": ["start", "end", "title"],
      "properties": {
        "start": { "type": "string" },
        "end": { "type": "string" },
        "title": { "type": "string" },
        "location_hint": { "type": "string" },
        "notes": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}

