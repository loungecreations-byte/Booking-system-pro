        public static function render_account_mijn_dagen() {
          // Zoek orders met meta _ddb_planning_data.
          // Toon lijst:
          //  - datum (eerste activity date)
          //  - titel (bijv. "Jouw dag in Den Bosch")
          //  - link "Bekijk dag" (simpele detailweergave)
