  run: >
    Maak ${vars.plugin_dir}/includes/Woo/Integration.php met namespace ${vars.ns}\Woo;

    class Integration {
        public static function init() {
          // Hook op:
          // - woocommerce_checkout_order_processed
          // - woocommerce_get_item_data
