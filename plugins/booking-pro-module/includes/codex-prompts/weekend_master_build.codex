[FILE] core/bootstrap.php
<?php
declare(strict_types=1);
namespace BSP\Core;
require_once __DIR__ . '/../vendor/autoload.php';
use BSP\Core\Modules;

final class Bootstrap {
  public static function init(): void {
    Modules::register('commerce', \BSP\Commerce\Module::class);
    Modules::register('planner', \BSP\Planner\Module::class);
    Modules::register('sales', \BSP\Sales\Module::class);
    Modules::register('intelligence', \BSP\Intelligence\Module::class);
    Modules::loadAll();
  }
}
Bootstrap::init();

[FILE] core/src/Interfaces/ModuleInterface.php
<?php
declare(strict_types=1);
namespace BSP\Core\Interfaces;

/** Elk module implementeert init() en registreert hooks, routes, services. */
interface ModuleInterface {
  public function init(): void;
}

[FILE] core/src/Modules.php
<?php
declare(strict_types=1);
namespace BSP\Core;
use BSP\Core\Interfaces\ModuleInterface;

final class Modules {
  /** @var array<string,class-string<ModuleInterface>> */
  private static array $registry = [];

  public static function register(string $key, string $class): void {
    self::$registry[$key] = $class;
  }

  public static function isRegistered(string $key): bool {
    return array_key_exists($key, self::$registry);
  }

  public static function load(string $key): void {
    if (!self::isRegistered($key)) return;
    $class = self::$registry[$key];
    if (\class_exists($class)) {
      $instance = new $class();
      if ($instance instanceof ModuleInterface) {
        $instance->init();
      }
    }
  }

  public static function loadAll(): void {
    foreach (array_keys(self::$registry) as $key) {
      self::load($key);
    }
  }
}

