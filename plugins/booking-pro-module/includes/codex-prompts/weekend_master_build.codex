# -----------------------------
# MODULE: INTELLIGENCE
# Doel: trends, anomalieën, forecast, upsell, segmentatie, KPI's
# Functies:
# - analyzeTrends(array $kv, int $k): array
# - detectAnomalies(array $series, float $threshold): array
# - forecastDemand(array $series, int $window): array
# - recommendUpsell(array $cart, array $catalog): array
# - computeKPIs(array $metrics): array
# - segmentCustomers(array $customers): array
# REST:
# - POST /bsp/v1/intel/trends
# - POST /bsp/v1/intel/forecast
# -----------------------------
[FILE] modules/intelligence/Module.php
<?php
declare(strict_types=1);
namespace BSP\Intelligence;

use BSP\Core\Interfaces\ModuleInterface;
use BSP\Core\CoreServiceProvider;

final class Module implements ModuleInterface {
  public function init(): void {
    CoreServiceProvider::logger()->log('Intelligence module initialized');
    if (\function_exists('add_action')) {
      \add_action('rest_api_init', [\BSP\Intelligence\Rest\Controller::class, 'register']);
    }
  }

  public function analyzeTrends(array $kv, int $k = 3): array {
    \arsort($kv);
    return \array_slice($kv, 0, $k, true);
  }

  public function detectAnomalies(array $series, float $threshold): array {
    $out = [];
    foreach ($series as $t => $v) {
      $val = (float)$v;
      if ($val >= $threshold) { $out[(string)$t] = $val; }
    }
    return $out;
  }

  public function forecastDemand(array $series, int $window = 3): array {
    $keys = \array_keys($series); $vals = \array_values($series);
    $n = \count($vals); $out = [];
    for ($i = 0; $i < $n; $i++) {
      $start = \max(0, $i - $window + 1);
      $slice = \array_slice($vals, $start, $i - $start + 1);
      $out[(string)$keys[$i]] = \array_sum($slice) / \max(1, \count($slice));
    }
    return $out;
  }

  /** Suggest simpele upsells o.b.v. catalogus 'related' velden. */
  public function recommendUpsell(array $cart, array $catalog): array {
    $inCart = \array_column($cart, 'sku');
    $suggested = [];
    foreach ($catalog as $item) {
      $related = \is_array($item['related'] ?? null) ? $item['related'] : [];
      foreach ($related as $sku) {
        if (!\in_array($sku, $inCart, true)) { $suggested[$sku] = true; }
      }
    }
    return \array_keys($suggested);
  }

  /** KPI’s doorrekenen; accepteert bijv. ['orders'=>10,'revenue'=>123.45]. */
  public function computeKPIs(array $metrics): array {
    $orders  = (int)($metrics['orders'] ?? 0);
    $revenue = (float)($metrics['revenue'] ?? 0);
    $aov = $orders > 0 ? $revenue / $orders : 0.0;
    return [
      'orders' => $orders,
      'revenue' => \round($revenue, 2),
      'aov' => \round($aov, 2)
    ];
  }

  /** Simpele segmentatie op basis van omzet. */
  public function segmentCustomers(array $customers): array {
    $out = ['VIP'=>[], 'REGULAR'=>[], 'NEW'=>[]];
    foreach ($customers as $c) {
      $sum = (float)($c['total'] ?? 0);
      $id  = (string)($c['id'] ?? '');
      if ($sum >= 1000) { $out['VIP'][] = $id; }
      elseif ($sum >= 100) { $out['REGULAR'][] = $id; }
      else { $out['NEW'][] = $id; }
    }
    return $out;
  }
}

