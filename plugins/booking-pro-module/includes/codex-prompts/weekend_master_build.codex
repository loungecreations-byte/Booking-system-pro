# -----------------------------
# MODULE: COMMERCE
# Doel: prijsbepaling, orderverwerking, voorraad (stub), kortingsregels
# Functies (implementeren):
# - processOrder(int $orderId): string
# - calculatePrice(float $base, array $rules): float
# - applyCoupons(array $items, array $coupons): array
# - reserveInventory(array $items): bool
# - saveOrderMeta(int $orderId, array $meta): bool
# - getOrderStatus(int $orderId): string
# REST:
# - POST /bsp/v1/commerce/calc-price
# - POST /bsp/v1/commerce/process-order
# -----------------------------
[FILE] modules/commerce/Module.php
<?php
declare(strict_types=1);
namespace BSP\Commerce;

use BSP\Core\Interfaces\ModuleInterface;
use BSP\Core\CoreServiceProvider;

final class Module implements ModuleInterface {
  public function init(): void {
    CoreServiceProvider::logger()->log('Commerce module initialized');
    if (\function_exists('add_action')) {
      \add_action('rest_api_init', [\BSP\Commerce\Rest\Controller::class, 'register']);
    }
  }

  /** Verwerk een order (stub-implementatie). */
  public function processOrder(int $orderId): string {
    return "Processing order #{$orderId}";
  }

  /** Eenvoudige prijsregels: percent|fixed. */
  public function calculatePrice(float $base, array $rules = []): float {
    $price = $base;
    foreach ($rules as $rule) {
      $type = (string)($rule['type'] ?? '');
      $val  = (float)($rule['value'] ?? 0);
      if ($type === 'percent') { $price += $base * ($val / 100.0); }
      if ($type === 'fixed')   { $price += $val; }
    }
    return \max(0.0, \round($price, 2));
  }

  /** Pas coupons toe op items; retourneert aangepaste items. */
  public function applyCoupons(array $items, array $coupons): array {
    $out = [];
    foreach ($items as $it) {
      $price = (float)($it['price'] ?? 0);
      foreach ($coupons as $c) {
        $type = (string)($c['type'] ?? '');
        $val  = (float)($c['value'] ?? 0);
        if ($type === 'percent') { $price -= $price * ($val / 100.0); }
        if ($type === 'fixed')   { $price -= $val; }
      }
      $it['price'] = \max(0.0, \round($price, 2));
      $out[] = $it;
    }
    return $out;
  }

  /** (Stub) Reserveer voorraad. */
  public function reserveInventory(array $items): bool {
    return !empty($items);
  }

  /** Sla ordermeta op (stub). */
  public function saveOrderMeta(int $orderId, array $meta): bool {
    return $orderId > 0;
  }

  /** (Stub) Geef orderstatus terug. */
  public function getOrderStatus(int $orderId): string {
    return $orderId > 0 ? 'processing' : 'unknown';
  }
}

[FILE] modules/commerce/Rest/Controller.php
<?php
declare(strict_types=1);
namespace BSP\Commerce\Rest;

use BSP\Commerce\Module;

final class Controller {
  public static function register(): void {
    if (!\function_exists('register_rest_route')) return;
    \register_rest_route('bsp/v1', '/commerce/calc-price', [
      'methods'  => 'POST',
      'callback' => [self::class, 'calcPrice'],
      'permission_callback' => '__return_true'
    ]);
    \register_rest_route('bsp/v1', '/commerce/process-order', [
      'methods'  => 'POST',
      'callback' => [self::class, 'processOrder'],
      'permission_callback' => '__return_true'
    ]);
  }

  public static function calcPrice($request) {
    $base  = (float)($request['base'] ?? 0);
    $rules = \is_array($request['rules'] ?? null) ? $request['rules'] : [];
    $mod   = new Module();
    $price = $mod->calculatePrice($base, $rules);
    return \function_exists('rest_ensure_response') ? \rest_ensure_response(['price' => $price]) : ['price' => $price];
  }

  public static function processOrder($request) {
    $id  = (int)($request['orderId'] ?? 0);
    $mod = new Module();
    $msg = $mod->processOrder($id);
    return \function_exists('rest_ensure_response') ? \rest_ensure_response(['message' => $msg]) : ['message' => $msg];
  }
}

# -----------------------------
# MODULE: PLANNER
# Doel: planning, overlapping detectie, beschikbaarheid, resource toewijzing
# Functies:
# - generateSchedule(array $bookings): array
# - hasOverlap(array $bookings): bool
# - availableSlots(array $allSlots, array $bookedSlots): array
# - assignResource(array $booking, array $resources): array
# - moveBooking(int $bookingId, string $newTime): bool
# - validateBooking(array $booking): array  (errors[])
# REST:
# - POST /bsp/v1/planner/schedule
# - POST /bsp/v1/planner/availability
# -----------------------------
[FILE] modules/planner/Module.php
<?php
declare(strict_types=1);
namespace BSP\Planner;

use BSP\Core\Interfaces\ModuleInterface;
use BSP\Core\CoreServiceProvider;

final class Module implements ModuleInterface {
  public function init(): void {
    CoreServiceProvider::logger()->log('Planner module initialized');
    if (\function_exists('add_action')) {
      \add_action('rest_api_init', [\BSP\Planner\Rest\Controller::class, 'register']);
    }
  }

  public function generateSchedule(array $bookings): array {
    $timeline = [];
    foreach ($bookings as $b) {
      $timeline[] = [
        'slot'    => (string)($b['time'] ?? ''),
        'label'   => (string)($b['name'] ?? ''),
        'resource'=> (string)($b['resource'] ?? '')
      ];
    }
    return $timeline;
  }

  public function hasOverlap(array $bookings): bool {
    $seen = [];
    foreach ($bookings as $b) {
      $key = (string)($b['resource'] ?? '') . '|' . (string)($b['time'] ?? '');
      if (isset($seen[$key])) return true;
      $seen[$key] = true;
    }
    return false;
  }

  public function availableSlots(array $allSlots, array $bookedSlots): array {
    return \array_values(\array_diff($allSlots, $bookedSlots));
  }

  public function assignResource(array $booking, array $resources): array {
    $booking['resource'] = $resources[0]['id'] ?? ($resources[0] ?? 'default');
    return $booking;
  }

  public function moveBooking(int $bookingId, string $newTime): bool {
    return $bookingId > 0 && $newTime !== '';
  }

  /** Retourneer lijst met fouten, leeg = valid. */
  public function validateBooking(array $booking): array {
    $errors = [];
    if (empty($booking['time'])) { $errors[] = 'time_required'; }
    if (empty($booking['name'])) { $errors[] = 'name_required'; }
    return $errors;
  }
}

[FILE] modules/planner/Rest/Controller.php
<?php
declare(strict_types=1);
namespace BSP\Planner\Rest;

use BSP\Planner\Module;

final class Controller {
  public static function register(): void {
    if (!\function_exists('register_rest_route')) return;
    \register_rest_route('bsp/v1', '/planner/schedule', [
      'methods'  => 'POST',
      'callback' => [self::class, 'schedule'],
      'permission_callback' => '__return_true'
    ]);
    \register_rest_route('bsp/v1', '/planner/availability', [
      'methods'  => 'POST',
      'callback' => [self::class, 'availability'],
      'permission_callback' => '__return_true'
    ]);
  }

  public static function schedule($request) {
    $bookings = \is_array($request['bookings'] ?? null) ? $request['bookings'] : [];
    $mod = new Module();
    $data = $mod->generateSchedule($bookings);
    return \function_exists('rest_ensure_response') ? \rest_ensure_response($data) : $data;
  }

  public static function availability($request) {
    $all    = \is_array($request['all'] ?? null) ? $request['all'] : [];
    $booked = \is_array($request['booked'] ?? null) ? $request['booked'] : [];
    $mod = new Module();
    $data = $mod->availableSlots($all, $booked);
    return \function_exists('rest_ensure_response') ? \rest_ensure_response(['available' => $data]) : ['available' => $data];
  }
}

# -----------------------------
# MODULE: SALES
# Doel: omzet, top producten, promoties (simpel), feeds, conversie
# Functies:
# - calculateRevenue(array $orders): float
# - topProducts(array $orderLines, int $limit): array
# - conversionRate(int $visitors, int $orders): float
# - buildSalesFeed(array $orders): array
# - runPromotionEngine(array $cart, array $rules): array
# - cohortRevenue(array $orders): array
# REST:
# - POST /bsp/v1/sales/revenue
# - POST /bsp/v1/sales/top-products
# -----------------------------
[FILE] modules/sales/Module.php
<?php
declare(strict_types=1);
namespace BSP\Sales;

use BSP\Core\Interfaces\ModuleInterface;
use BSP\Core\CoreServiceProvider;

final class Module implements ModuleInterface {
  public function init(): void {
    CoreServiceProvider::logger()->log('Sales module initialized');
    if (\function_exists('add_action')) {
      \add_action('rest_api_init', [\BSP\Sales\Rest\Controller::class, 'register']);
    }
  }

  public function calculateRevenue(array $orders): float {
    $sum = 0.0;
    foreach ($orders as $o) { $sum += (float)($o['amount'] ?? 0); }
    return \round($sum, 2);
  }

  public function topProducts(array $orderLines, int $limit = 3): array {
    $counts = [];
    foreach ($orderLines as $line) {
      $sku = (string)($line['sku'] ?? '');
      $counts[$sku] = ($counts[$sku] ?? 0) + (int)($line['qty'] ?? 0);
    }
    \arsort($counts);
    return \array_slice($counts, 0, $limit, true);
  }

  public function conversionRate(int $visitors, int $orders): float {
    if ($visitors <= 0) return 0.0;
    return \round(($orders / $visitors) * 100, 2);
  }

  public function buildSalesFeed(array $orders): array {
    return \array_map(static fn($o) => [
      'id'     => $o['id'] ?? null,
      'amount' => (float)($o['amount'] ?? 0),
      'ts'     => $o['timestamp'] ?? null
    ], $orders);
  }

  /** Eenvoudige promotie-engine: rules op cart toepassen. */
  public function runPromotionEngine(array $cart, array $rules): array {
    $total = 0.0;
    foreach ($cart as $item) { $total += (float)($item['price'] ?? 0) * (int)($item['qty'] ?? 1); }
    foreach ($rules as $rule) {
      $type = (string)($rule['type'] ?? '');
      $val  = (float)($rule['value'] ?? 0);
      if ($type === 'percent') { $total -= $total * ($val / 100.0); }
      if ($type === 'fixed')   { $total -= $val; }
    }
    return ['total' => \max(0.0, \round($total, 2))];
  }

  /** Omzet per cohort-maand (YYYY-MM). */
  public function cohortRevenue(array $orders): array {
    $cohorts = [];
    foreach ($orders as $o) {
      $ts = (string)($o['timestamp'] ?? '');
      $ym = \substr($ts, 0, 7);
      $cohorts[$ym] = ($cohorts[$ym] ?? 0.0) + (float)($o['amount'] ?? 0);
    }
    \ksort($cohorts);
    foreach ($cohorts as $k => $v) { $cohorts[$k] = \round($v, 2); }
    return $cohorts;
  }
}

