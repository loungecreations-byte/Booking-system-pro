{
  "name": "booking-pro-module",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.js",
    "build": "node ./scripts/build-release.mjs",
    "build:vite": "vite build --config vite.config.js --configLoader native",
    "preview": "vite preview --config vite.config.js",
    "test:e2e:mvp": "node ./node_modules/@playwright/test/cli.js test tests/e2e/planner-combi.spec.ts tests/e2e/planner-journey.spec.ts",
    "lint:css": "stylelint \"assets/css/ddb-ui.css\"",
    "check:no-important": "pwsh -File ./scripts/check-no-important.ps1",
    "check:app-stylesheets": "pwsh -File ./scripts/check-app-stylesheets.ps1",
    "check:app-stylesheets:strict": "pwsh -File ./scripts/check-app-stylesheets.ps1 -Strict"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stylelint": "^16.15.0",
    "stylelint-config-standard": "^37.0.0",
    "vite": "^7.1.10"
  },
  "dependencies": {
    "@wordpress/i18n": "^6.7.0",
    "lucide-react": "^0.556.0",
    "prop-types": "^15.8.1"
  }
}
