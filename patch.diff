diff --git a/dist/booking-pro-module-3.0-fixed1/booking-pro-module/modules/shared/Agents/CoreAgent.php b/dist/booking-pro-module-3.0-fixed1/booking-pro-module/modules/shared/Agents/CoreAgent.php
